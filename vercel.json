{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/perfumes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://velaris-production.up.railway.app/api/:path*"
    },
    {
      "source": "/((?!assets/|perfumes/|.*\\.(?:js|css|jpg|jpeg|png|gif|svg|ico|json|woff|woff2)).*)",
      "destination": "/index.html"
    }
  ]
}
